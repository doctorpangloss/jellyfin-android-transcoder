<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.AndroidTranscoder</AssemblyName>
    <Version>1.1.13.1</Version>
    <AssemblyVersion>1.1.13.1</AssemblyVersion>
    <FileVersion>1.1.13.1</FileVersion>
    <InformationalVersion>1.1.13.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <Content Include="shim-payload\jfat-ffmpeg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('shim-payload\jfat-ffmpeg')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JellyfinAndroidTranscoder.Shim.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
